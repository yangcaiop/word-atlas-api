# 容器固定使用 3000 端口；宿主机映射端口通过 API_PORT 调整。
LOG_LEVEL=info
CORS_ORIGINS=https://words.example.com
JSON_BODY_LIMIT_MB=5
SESSION_DAYS=30
AUTH_RATE_LIMIT=30
COOKIE_SECURE=true
# 单层可信服务器反向代理；接入边缘函数后按实际代理链调整。
TRUST_PROXY_HOPS=1

# 与 docker/mysql/mysql.env 中的数据库、账号一致。
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=word_atlas
DB_USER=word_atlas
DB_PASSWORD_FILE=/run/secrets/mysql_password
