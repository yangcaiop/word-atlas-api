NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 多个前端来源用逗号分隔，填写协议、域名和端口，不包含页面路径。
CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188

JSON_BODY_LIMIT_MB=5

# 先创建数据库，再运行 npm run db:migrate。密码中的特殊字符需 URL 编码。
MYSQL_URL=mysql://root@127.0.0.1:3306/word_atlas
SESSION_DAYS=30
AUTH_RATE_LIMIT=30
# 默认生产环境 true，开发环境 false；生产环境请通过 HTTPS 访问。
# COOKIE_SECURE=true

# 单层可信反向代理时设为 1，并限制 API 只能由该代理访问。
TRUST_PROXY_HOPS=0
